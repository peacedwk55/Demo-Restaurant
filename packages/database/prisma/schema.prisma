generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// TENANTS  (SaaS multi-tenant)
// ─────────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  bannerUrl      String?
  primaryColor   String   @default("#F97316")
  address        String?
  phone          String?
  currency       String   @default("THB")
  timezone       String   @default("Asia/Bangkok")
  promptPayId    String?
  googleMapsUrl  String?
  isActive       Boolean  @default(true)
  plan           Plan     @default(FREE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  tables      Table[]
  categories  Category[]
  menuItems   MenuItem[]
  orders      Order[]
  reviews     Review[]

  @@map("tenants")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
// USERS  (Staff)
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  pin          String?
  name         String
  avatarUrl    String?
  role         UserRole
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
  KITCHEN
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─────────────────────────────────────────────
// TABLES
// ─────────────────────────────────────────────

model Table {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  name      String
  capacity  Int         @default(4)
  zone      String?
  status    TableStatus @default(AVAILABLE)
  qrCodeUrl String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, code])
  @@map("tables")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  PAYMENT_PENDING
  CLEANING
}

// ─────────────────────────────────────────────
// MENU
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  nameEn    String?
  icon      String?
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String
  name            String
  nameEn          String?
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  isPopular       Boolean  @default(false)
  isNew           Boolean  @default(false)
  preparationTime Int?
  calories        Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  optionGroups OptionGroup[]
  orderItems   OrderItem[]

  @@map("menu_items")
}

model OptionGroup {
  id         String          @id @default(cuid())
  menuItemId String
  name       String
  nameEn     String?
  type       OptionGroupType @default(SINGLE)
  required   Boolean         @default(false)
  minSelect  Int             @default(0)
  maxSelect  Int             @default(1)
  sortOrder  Int             @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  Option[]

  @@map("option_groups")
}

enum OptionGroupType {
  SINGLE
  MULTIPLE
}

model Option {
  id            String  @id @default(cuid())
  optionGroupId String
  name          String
  nameEn        String?
  priceAdjust   Decimal @default(0) @db.Decimal(10, 2)
  isDefault     Boolean @default(false)
  sortOrder     Int     @default(0)

  optionGroup      OptionGroup      @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@map("options")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  tableId     String
  sessionCode String
  orderNumber Int
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  notes       String?
  servedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  table      Table       @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  payment    Payment?
  review     Review?
  staffCalls StaffCall[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model OrderItem {
  id         String     @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal    @db.Decimal(10, 2)
  totalPrice Decimal    @db.Decimal(10, 2)
  notes      String?
  status     ItemStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])
  options  OrderItemOption[]

  @@map("order_items")
}

enum ItemStatus {
  PENDING
  PREPARING
  DONE
  CANCELLED
}

model OrderItemOption {
  id          String  @id @default(cuid())
  orderItemId String
  optionId    String
  name        String
  priceAdjust Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    Option    @relation(fields: [optionId], references: [id])

  @@map("order_item_options")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  tenantId       String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(PROMPTPAY)
  status         PaymentStatus @default(PENDING)
  promptPayQrUrl String?
  transactionRef String?
  confirmedBy    String?
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  PROMPTPAY
  CASH
  CREDIT_CARD
  STRIPE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  tenantId            String
  rating              Int
  emoji               String?
  comment             String?
  redirectedToGoogle  Boolean  @default(false)
  createdAt           DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("reviews")
}

// ─────────────────────────────────────────────
// STAFF CALLS
// ─────────────────────────────────────────────

model StaffCall {
  id         String        @id @default(cuid())
  orderId    String
  type       StaffCallType
  message    String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("staff_calls")
}

enum StaffCallType {
  ASSISTANCE
  PAYMENT
  WATER
  CUSTOM
}
